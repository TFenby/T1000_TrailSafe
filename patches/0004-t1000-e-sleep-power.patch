+
+// Called from cpuDeepSleep() after Wire.end(), for timed sleep and shutdown alike; initVariant() undoes it on the
+// reboot. sleep.cpp has already cut the sensor (PIN_3V3_EN), buzzer and GPS rails and turned the LED off.
+void variant_shutdown()
+{
+    digitalWrite(PIN_3V3_ACC_EN, LOW); // accelerometer rail, after I2C is released
+    pinMode(QMA_6100P_INT_PIN, INPUT);
+    // Seeed documents P0.04 as an analog VCC sense input, Meshtastic drives it as a sensor enable: release it, which is
+    // safe either way and cannot back-feed the sensor rail that is now off.
+    pinMode(T1000X_SENSOR_EN_PIN, INPUT);
+}
