+// Leave why the sleep ended in GPREGRET2 for the boot after NVIC_SystemReset(). The bootloader and the core only use
+// GPREGRET; the SoftDevice owns the register while it is enabled, so go through it when it is.
+static void setTrackerWakeCause(TrackerWakeCause cause)
+{
+    if (sd_power_gpregret_clr(1, 0xFF) != NRF_SUCCESS || sd_power_gpregret_set(1, cause) != NRF_SUCCESS)
+        NRF_POWER->GPREGRET2 = cause;
+}
