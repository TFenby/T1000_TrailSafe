+/// A power-saving tracker deep-sleeps as soon as its position is out, so holding the receiver on after the fix to
+/// refresh ephemeris would only delay that; it gets a zero-length hold (publish, then down()).
+static bool sleepsAfterFix()
+{
+    return config.power.is_power_saving &&
+           IS_ONE_OF(config.device.role, meshtastic_Config_DeviceConfig_Role_TRACKER,
+                     meshtastic_Config_DeviceConfig_Role_TAK_TRACKER);
+}
